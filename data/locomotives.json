    { "id": "emc-nw1", "builder": "EMC", "model": "NW1", "variant": null, "role": "Switcher", "branch": "switcher", "years": "1937–1939", "horsepower": 900, "axleConfiguration": "B-B", "tractionType": "Diesel-electric", "primeMover": "Winton 12-201-A", "engineConfiguration": "V12", "productionCount": 27, "maximumSpeedMph": 50, "approximateWeightLb": 198000, "approximateLength": "44 ft 5 in", "narrative": ["The EMC NW1 was a 900-horsepower B-B switcher built from 1937 through 1939. Powered by the Winton 12-201-A, it belonged to the last generation of EMC switchers before Electro-Motive’s transition to the 567 engine.", "Only 27 NW1 locomotives were built, making it far less numerous than the later NW2. Its importance in this collection is technological rather than numerical: the NW1 forms a clear bridge between the Winton-powered EMC era and the 567-powered NW2 that followed.", "The designation reflected EMC’s contemporary naming convention: ‘N’ indicated the 900-horsepower class and ‘W’ indicated a welded frame. This was historical EMC nomenclature, not a modern classification scheme.", "The NW1 is not currently a purchase target. It is included as historical context for the owned NW2 and is especially relevant because both Chicago, Burlington & Quincy and Great Northern owned NW1 locomotives within the collection’s BNSF-predecessor scope."], "operatorIds": ["chicago-burlington-quincy", "great-northern"], "images": [], "predecessors": [], "successors": ["emd-nw2"], "collectionRelevance": "historical_only", "sourceIds": ["wikipedia-emc-winton-switchers", "american-rails-early-emc-switchers"], "timeline": { "manufacturing": { "start": 1937, "end": 1939, "sourceIds": ["american-rails-early-emc-switchers"] }, "lineageService": [{ "railroadId": "chicago-burlington-quincy", "start": 1937, "end": 1965, "sourceIds": ["american-rails-early-emc-switchers", "flickr-chuck-zeiler-cbq-9201"] }, { "railroadId": "great-northern", "start": 1938, "end": 1953, "sourceIds": ["great-northern-empire-nw2-roster", "american-rails-great-northern-roster"] }] } },
    { "id": "emd-nw2", "builder": "EMD", "model": "NW2", "variant": null, "role": "Switcher", "branch": "switcher", "years": "February 1939 – December 1949", "horsepower": 1000, "axleConfiguration": "B-B", "tractionType": "Diesel-electric", "primeMover": "EMD 12-567 or 12-567A", "engineConfiguration": "V12", "productionCount": 1145, "narrative": ["The EMD NW2 was a 1,000-horsepower B-B diesel-electric switcher produced from 1939 through 1949. With 1,145 examples built, it became one of EMD’s important early mass-production switchers and helped establish the 567-engine generation that would underpin EMD’s rise in the diesel era."], "operatorIds": ["chicago-burlington-quincy", "great-northern", "northern-pacific", "santa-fe", "burlington-northern"], "images": [], "predecessors": ["emc-nw1"], "successors": [], "collectionRelevance": "historical_only", "sourceIds": ["wikipedia-emd-nw2", "american-rails-emd-nw2"], "timeline": { "manufacturing": { "start": 1939, "end": 1949, "sourceIds": ["american-rails-emd-nw2"] }, "lineageService": [{ "railroadId": "chicago-burlington-quincy", "start": 1940, "end": 1970, "operatedCount": 46, "sourceIds": ["diesel-shop-cbq-roster", "brhs-diesel-roster"] }, { "railroadId": "great-northern", "start": 1939, "end": 1970, "operatedCount": 53, "sourceIds": ["great-northern-empire-nw2-roster", "american-rails-great-northern-roster"] }, { "railroadId": "northern-pacific", "start": 1940, "end": 1970, "operatedCount": 7, "approximateStart": true, "sourceIds": ["diesel-shop-northern-pacific-roster"] }, { "railroadId": "burlington-northern", "start": 1970, "end": 1983, "sourceIds": ["trainpix-bn-nw2"] }, { "railroadId": "santa-fe", "start": 1939, "end": 1977, "operatedCount": 15, "sourceIds": ["atsf-nw2-master-roster"] }] } },
    { "id": "ge-u25b", "builder": "GE", "model": "U25B", "variant": null, "role": "Road switcher", "branch": "universal-four-axle", "years": "April 1959 – February 1966", "horsepower": 2500, "axleConfiguration": "B-B", "tractionType": "Diesel-electric", "primeMover": "GE FDL-16", "engineConfiguration": "V16", "productionCount": 478, "narrative": ["The U25B was General Electric’s breakthrough into the domestic road-locomotive market as an independent builder. Its 2,500-horsepower FDL-16 and four GE 752 traction motors established the pattern for GE’s Universal Series road power.", "Great Northern operated 24 U25Bs. GN 2514 was part of the railroad’s final Phase IV group of ten U25Bs, numbered 2514–2523 and delivered in spring 1965 for transcontinental freight service."], "operatorIds": ["great-northern", "chicago-burlington-quincy", "burlington-northern"], "images": [], "predecessors": [], "successors": ["ge-u28b", "ge-u23b"], "collectionRelevance": "historical_only", "sourceIds": ["rapido-u25b-master-class", "diesel-shop-u25b-roster", "gnrhs-u25b-models", "bn-u25b-history"], "timeline": { "manufacturing": { "start": 1959, "end": 1966, "sourceIds": ["rapido-u25b-master-class"] }, "lineageService": [{ "railroadId": "great-northern", "start": 1964, "end": 1970, "operatedCount": 24, "sourceIds": ["diesel-shop-u25b-roster", "gnrhs-u25b-models"] }, { "railroadId": "chicago-burlington-quincy", "start": 1964, "end": 1970, "operatedCount": 6, "sourceIds": ["bn-u25b-history"] }, { "railroadId": "burlington-northern", "start": 1970, "end": 1981, "operatedCount": 54, "sourceIds": ["bn-u25b-history", "trainpix-bn-roster"] }] } },
