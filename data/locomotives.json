    { "id": "emd-e7", "builder": "EMD", "model": "E7", "variant": null, "role": "Passenger cab unit", "branch": "passenger-cab", "years": "February 1945 – April 1949", "horsepower": 2000, "axleConfiguration": "A1A-A1A", "tractionType": "Diesel-electric", "primeMover": "EMD 12-567A", "engineConfiguration": "Two V12 engines", "productionCount": 510, "narrative": ["The EMD E7 was a 2,000-horsepower passenger locomotive built in cab-equipped A and cabless B versions. Its 510-unit production run made it the most numerous E-unit model.", "Chicago, Burlington & Quincy operated 44 E7A locomotives, including 9931B. Burlington Northern inherited E7s from CB&Q, Great Northern, and Spokane, Portland & Seattle; its 32-unit E7A fleet was short-lived as Amtrak assumed most intercity passenger service."], "operatorIds": ["chicago-burlington-quincy", "great-northern", "spokane-portland-seattle", "burlington-northern"], "images": [], "predecessors": [], "successors": ["emd-e8"], "collectionRelevance": "historical_only", "sourceIds": ["emd-e7-reference", "diesel-shop-cbq-roster", "great-northern-e7-roster", "trainpix-bn-e7a"], "timeline": { "manufacturing": { "start": 1945, "end": 1949, "sourceIds": ["emd-e7-reference"] }, "lineageService": [{ "railroadId": "chicago-burlington-quincy", "start": 1945, "end": 1970, "operatedCount": 44, "sourceIds": ["diesel-shop-cbq-roster"] }, { "railroadId": "great-northern", "start": 1945, "end": 1970, "operatedCount": 13, "sourceIds": ["great-northern-e7-roster"] }, { "railroadId": "spokane-portland-seattle", "start": 1948, "end": 1970, "operatedCount": 1, "sourceIds": ["spokane-portland-seattle-roster"] }, { "railroadId": "burlington-northern", "start": 1970, "end": 1974, "operatedCount": 32, "sourceIds": ["trainpix-bn-e7a"] }] } },
