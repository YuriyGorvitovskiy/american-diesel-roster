    { "id": "emd-nw2", "builder": "EMD", "model": "NW2", "variant": null, "role": "Switcher", "branch": "switcher", "years": "February 1939 – December 1949", "horsepower": 1000, "axleConfiguration": "B-B", "tractionType": "Diesel-electric", "primeMover": "EMD 12-567 or 12-567A", "engineConfiguration": "V12", "productionCount": 1145, "narrative": ["The EMD NW2 was a 1,000-horsepower B-B diesel-electric switcher produced from 1939 through 1949. With 1,145 examples built, it became one of EMD’s important early mass-production switchers and helped establish the 567-engine generation that would underpin EMD’s rise in the diesel era."], "operatorIds": ["chicago-burlington-quincy", "great-northern", "northern-pacific", "santa-fe", "burlington-northern"], "images": [], "predecessors": ["emc-nw1"], "successors": [], "collectionRelevance": "historical_only", "sourceIds": ["wikipedia-emd-nw2", "american-rails-emd-nw2"], "timeline": { "manufacturing": { "start": 1939, "end": 1949, "sourceIds": ["american-rails-emd-nw2"] }, "lineageService": [{ "railroadId": "chicago-burlington-quincy", "start": 1940, "end": 1970, "purchasedNewCount": 46, "sourceIds": ["diesel-shop-cbq-roster", "brhs-diesel-roster"] }, { "railroadId": "great-northern", "start": 1939, "end": 1970, "operatedCount": 53, "sourceIds": ["great-northern-empire-nw2-roster", "american-rails-great-northern-roster"] }, { "railroadId": "northern-pacific", "start": 1940, "end": 1970, "operatedCount": 7, "approximateStart": true, "sourceIds": ["diesel-shop-northern-pacific-roster"] }, { "railroadId": "burlington-northern", "start": 1970, "end": 1983, "sourceIds": ["trainpix-bn-nw2"] }, { "railroadId": "santa-fe", "start": 1939, "end": 1977, "operatedCount": 15, "sourceIds": ["atsf-nw2-master-roster"] }] } }
