    { "id": "emc-nw1", "builder": "EMC", "model": "NW1", "variant": null, "role": "Switcher", "branch": "switcher", "years": "1937–1939", "horsepower": 900, "axleConfiguration": "B-B", "tractionType": "Diesel-electric", "primeMover": "Winton 12-201-A", "engineConfiguration": "V12", "productionCount": 27, "maximumSpeedMph": 50, "approximateWeightLb": 198000, "approximateLength": "44 ft 5 in", "narrative": ["The EMC NW1 was a 900-horsepower B-B switcher built from 1937 through 1939. Powered by the Winton 12-201-A, it belonged to the last generation of EMC switchers before Electro-Motive’s transition to the 567 engine.", "Only 27 NW1 locomotives were built, making it far less numerous than the later NW2. Its importance in this collection is technological rather than numerical: the NW1 forms a clear bridge between the Winton-powered EMC era and the 567-powered NW2 that followed.", "The designation reflected EMC’s contemporary naming convention: ‘N’ indicated the 900-horsepower class and ‘W’ indicated a welded frame. This was historical EMC nomenclature, not a modern classification scheme.", "The NW1 is not currently a purchase target. It is included as historical context for the owned NW2 and is especially relevant because both Chicago, Burlington & Quincy and Great Northern owned NW1 locomotives within the collection’s BNSF-predecessor scope."], "operatorIds": ["chicago-burlington-quincy", "great-northern"], "images": [], "predecessors": [], "successors": ["emd-nw2"], "collectionRelevance": "historical_only", "sourceIds": ["wikipedia-emc-winton-switchers", "american-rails-early-emc-switchers"], "timeline": { "manufacturing": { "start": 1937, "end": 1939, "sourceIds": ["american-rails-early-emc-switchers"] }, "lineageService": [{ "railroadId": "chicago-burlington-quincy", "start": 1937, "end": 1965, "purchasedNewCount": 2, "sourceIds": ["american-rails-early-emc-switchers", "flickr-chuck-zeiler-cbq-9201"] }, { "railroadId": "great-northern", "start": 1938, "end": 1953, 